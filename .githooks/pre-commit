#!/bin/bash
# Pre-commit — TWO independent planes, deliberately not one.
#
# PLANE 1 (main's, kept): the required-hooks guard. Blocks any commit (including
# merges) whose .claude/settings.json has dropped a protected Claude Code hook.
#
# PLANE 2 (from yumi/hard-safety-guard): a SECOND TIE for hard safety. The
# dangerous-command guard runs on the HARNESS plane (PreToolUse in
# .claude/settings.json) and catches a command about to RUN. This catches a
# different thing on a different plane: a catastrophic command pattern about to
# LAND in a committed file, where it would run later under someone else's hands.
# They fail independently, which is the point — the harness plane is silently
# absent in multi-root and remote sessions (measured 2026-08-08, ten commits with
# every P0 guard inert).
#
# Enable: git config core.hooksPath .githooks
set -u
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"

if [ -x "$REPO_ROOT/.githooks/check-required-hooks.sh" ]; then
  "$REPO_ROOT/.githooks/check-required-hooks.sh" || exit 1
fi

# Skips silently if node is not on the hook's PATH.
if command -v node >/dev/null 2>&1 && [ -f "$REPO_ROOT/.claude/hooks/lib/scan-command.mjs" ]; then
  node "$REPO_ROOT/.claude/hooks/lib/scan-command.mjs" --git-staged || exit 1
fi

# --- change record (household) BEGIN: written by Project-Sophos admin/change-record-deploy.mjs; rerun it, do not edit by hand ---
# Every commit that changes this repository's code carries a change entry: why it mattered and what it
# enables (Ken 2026-10-27: "it should be required on a per commit bassis"). Content and generated files
# are exempt (lexicon/change-record.json). Judged by Project-Sophos admin/change-record.mjs; doc docs/lexicon/CHANGE-RECORD.md there.
# @exit 1 refused: a commit without its change entry, or one that is malformed, unproven or stale. remedy: the command each finding prints
# @exit 4 could not look: no Project-Sophos checkout at engine version 2 or later. remedy: set SOPHOS_ROOT to a current Project-Sophos checkout
# Kill-switch (operator only): CHANGE_RECORD=0.
if [ "${CHANGE_RECORD:-1}" != "0" ]; then
  _cr_root="$(git rev-parse --show-toplevel)"
  _cr_engine=""
  for _cr_try in "${SOPHOS_ROOT:-}" "$_cr_root/../Project-Sophos" "$_cr_root/../project-sophos" "${HOME:-}/Project-Sophos" "${HOME:-}/code/Project-Sophos"; do
    if [ -n "$_cr_try" ] && [ -f "$_cr_try/admin/change-record.mjs" ] && command -v node >/dev/null 2>&1; then
      _cr_v="$(node "$_cr_try/admin/change-record.mjs" version 2>/dev/null || true)"
      if [ "${_cr_v#change-record }" != "$_cr_v" ] && [ "${_cr_v#change-record }" -ge 2 ] 2>/dev/null; then _cr_engine="$_cr_try"; break; fi
    fi
  done
  if [ -z "$_cr_engine" ]; then
    echo "change-record: change_unavailable: no Project-Sophos checkout with engine version 2 or later (tried SOPHOS_ROOT, ../Project-Sophos, ~/Project-Sophos, ~/code/Project-Sophos)." >&2
    echo "change-record: NOT CHECKED (change_unavailable) - allowing the commit. Set SOPHOS_ROOT to a current Project-Sophos checkout so it is judged." >&2
  else
    _cr_rc=0
    if node "$_cr_engine/admin/change-record.mjs" check --staged --repo "$_cr_root"; then _cr_rc=0; else _cr_rc=$?; fi
    if [ "$_cr_rc" = "4" ]; then
      echo "change-record: NOT CHECKED (change_unavailable) - allowing the commit. Set SOPHOS_ROOT to a current Project-Sophos checkout so it is judged." >&2
    elif [ "$_cr_rc" != "0" ]; then
      echo "pre-commit: REFUSING, see change-record above. Codes and remedies: $_cr_engine/docs/lexicon/CHANGE-RECORD.md" >&2
      exit 1
    fi
  fi
fi
# --- change record (household) END ---

exit 0
